<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.multimedia_project.gui.DocumentSearchController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label text="Document Search Criteria" style="-fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10">
        <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="categoryCombo" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Title Contains:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Author Contains:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="authorField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <Button text="Search Documents" onAction="#handleSearch" style="-fx-base: #4CAF50;" />

    <Separator />

    <Label text="Search Results" style="-fx-font-weight: bold;" />
    
    <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="250.0" />
            <TableColumn fx:id="authorColumn" text="Author" prefWidth="150.0" />
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150.0" />
            <TableColumn fx:id="dateColumn" text="Creation Date" prefWidth="120.0" />
            <TableColumn fx:id="versionColumn" text="Version" prefWidth="60.0" />
        </columns>
    </TableView>

    <Separator />
    
    <VBox spacing="10.0" fx:id="detailsContainer" visible="false">
        <Label text="Document Details" style="-fx-font-weight: bold; -fx-font-size: 16;" />
        
        <GridPane hgap="10" vgap="5">
            <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="detailTitleLabel" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="Author:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="detailAuthorLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Latest Version:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="detailVersionLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Creation Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="detailDateLabel" style="-fx-font-style: italic;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        </GridPane>
        
        <TextArea fx:id="detailContentArea" editable="false" wrapText="true" prefHeight="200.0" />
        <Button fx:id="followButton" text="Follow Document" onAction="#handleFollowDocument" 
            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" />
    </VBox>
</VBox>