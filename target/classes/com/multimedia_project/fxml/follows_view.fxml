<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0.0" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.multimedia_project.gui.FollowsController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
    </padding>

    <Region prefHeight="25.0" />

    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" 
               style="-fx-background-color: transparent; -fx-padding: 0;">
        
        <VBox spacing="10.0" alignment="TOP_CENTER">
            <Label text="Available Documents (Not Following)" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
            <ListView fx:id="availableDocumentsListView" VBox.vgrow="ALWAYS" />
            
            <Button fx:id="addFollowButton" text="Start Following" onAction="#handleAddFollow" 
                    style="-fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" 
                    prefWidth="250.0" visible="false" />
        </VBox>
        
        <VBox spacing="10.0" alignment="TOP_CENTER">
            <Label text="Currently Followed Documents" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
            <ListView fx:id="followedDocumentsListView" VBox.vgrow="ALWAYS" />
            
            <Button fx:id="removeFollowButton" text="Stop Following" onAction="#handleRemoveFollow" 
                    style="-fx-base: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;" 
                    prefWidth="250.0" visible="false" />
        </VBox>
        
    </SplitPane>
    
    <Region prefHeight="10.0" />
</VBox>