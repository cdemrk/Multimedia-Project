<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.multimedia_project.gui.UnifiedDocumentController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="newDocumentButton" text="+ New Document" onAction="#handleNewDocument" 
                style="-fx-base: #5cb85c; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="30" prefWidth="70" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
        </columnConstraints>
        
        <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="categorySearchCombo" prefWidth="250.0" onAction="#handleSearch" 
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="🔍" style="-fx-font-size: 20px;" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.halignment="CENTER" />
        
        <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <TextField fx:id="titleSearchField" onAction="#handleSearch" 
                       promptText="Search by title..." prefWidth="250.0" />
            <Button text="Search" onAction="#handleSearch" 
                    style="-fx-base: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" />
        </HBox>
    </GridPane>

    <Separator />

    <SplitPane dividerPositions="0.4" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        
        <VBox spacing="5.0">
            <Label text="Results List" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
            <ListView fx:id="documentListView" VBox.vgrow="ALWAYS" />
        </VBox>
        
        <StackPane>
            <padding>
                <Insets left="10.0" right="15.0" />
            </padding>
            
            <VBox fx:id="placeholderBox" alignment="CENTER" spacing="15.0">
                <Label text="📄" style="-fx-font-size: 48px; -fx-text-fill: #cccccc;" />
                <Label text="Select a Document" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #888888;" />
                <Label text="Choose a document from the list on the left to view or edit its contents." style="-fx-text-fill: #999999;" />
            </VBox>

            <VBox fx:id="documentDetailsBox" spacing="10.0" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox>
                        <Label fx:id="detailTitleLabel" text="Title" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                        <Label fx:id="detailAuthorLabel" text="Author Info" style="-fx-text-fill: #666;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    
                    <Button fx:id="followButton" text="Follow" onAction="#handleFollow" 
                            style="-fx-base: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" />
                            
                    <Button fx:id="deleteDocumentButton" text="Delete" onAction="#handleDelete" 
                            style="-fx-base: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;" />
                </HBox>

                <Separator />

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Version:" />
                    <ComboBox fx:id="versionSelectorCombo" onAction="#handleVersionChange" prefWidth="80.0" />
                    <Label fx:id="versionInfoLabel" text="V1 | 2024-01-01" style="-fx-font-style: italic;" />
                    <Region HBox.hgrow="ALWAYS" />
                    
                    <Button fx:id="editDocumentButton" text="Edit Mode" onAction="#handleEdit" 
                            style="-fx-font-weight: bold;" />
                </HBox>

                <TextArea fx:id="contentDisplayArea" VBox.vgrow="ALWAYS" wrapText="true" editable="false" 
                          style="-fx-font-family: 'Monospaced'; -fx-font-size: 13px;" />

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="saveChangesButton" text="Save Changes" onAction="#handleSave" 
                            style="-fx-base: #2e649d; -fx-text-fill: white; -fx-font-weight: bold;" visible="false" />
                </HBox>
            </VBox>
        </StackPane>
    </SplitPane>
</VBox>